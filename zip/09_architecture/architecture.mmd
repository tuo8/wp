flowchart TD
    APP["官方 Android 客户端 1.0.24<br/>Flutter + 本地 SQLite 同步引擎"]
    WEB["官方 Web 客户端 drive.2dland.cn<br/>同一 gRPC-Web 协议"]
    AUTH["ucenter.2dland.cn<br/>OAuth 设备码授权"]
    API["drcdn2.2dland.cn (envoy)<br/>gRPC-Web /v6.services.pub.*"]
    UP["simple-file-proxy.2dland.cn<br/>POST /int/blocks/{session}/{cid}"]
    META["commit: POST /int/blocks/{session}<br/>body=[cid...] → content_identity"]
    DAG["UnixFS 根生成（服务端）<br/>3.15 GiB → 807 links / 41 973 B 单层"]
    STORE[("自建内容寻址块存储<br/>/ipfs/blocks/{a}/{bc}/{cid}<br/>回源 pic01–04.hhhtcu")]
    SLICE["slices.qzy.xyz<br/>加密分片网关<br/>每块随机 XOR 键"]
    GW["ipfs-gateway.qzy.xyz<br/>明文整文件网关<br/>Range 206 / ETag=CID"]
    CDN["多层 CDN<br/>via: cacheXX.isp, age 0–2"]
    DB[("本地 SQLite halalcloud.db.sqlite<br/>同步任务状态 / 下载线程数 4")]

    APP -->|"1 OAuth"| AUTH
    APP -->|"2 gRPC-Web 签名请求"| API
    WEB -->|"同协议"| API
    APP --- DB
    API -->|"3 CreateUploadTask"| UP
    APP -->|"4 上传块 4 MiB/块 raw CID"| UP
    UP -->|"5 commit 块清单"| META
    META --> DAG
    DAG -->|"6 写入"| STORE
    API -->|"7a GetSliceDownloadAddress（下载）"| SLICE
    API -->|"7b GetDirectDownloadAddress（播放）"| GW
    SLICE -->|"读块 + XOR"| STORE
    GW -->|"遍历 DAG + 按字节拼接"| STORE
    SLICE --- CDN
    GW --- CDN
    APP -->|"8a 下载：4 并发逐块，落盘 downloads/"| CDN
    APP -->|"8b 播放：渐进拉流，不落盘"| CDN
    WEB -->|"下载 / 预览"| CDN

    classDef unknown fill:#eee,stroke:#999,stroke-dasharray: 4 3
    class STORE unknown
