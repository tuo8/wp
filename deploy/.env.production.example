# Copy to deploy/.env.production and fill with real values. Never commit the real file.
# Pin images to a reviewed tag or, preferably, an immutable sha256 digest.
PYTHON_BASE_IMAGE=python:3.11-slim-bookworm
MINIO_IMAGE=REPLACE_WITH_PINNED_MINIO_TAG_OR_DIGEST
MINIO_MC_IMAGE=REPLACE_WITH_PINNED_MINIO_MC_TAG_OR_DIGEST
MYDRIVE_IMAGE_TAG=production
PUBLIC_BIND_IP=127.0.0.1

# Generate each secret independently; each must be at least 32 characters.
MYDRIVE_SECRET=REPLACE_WITH_RANDOM_SECRET
MYDRIVE_PRESIGN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
ARIA2_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_PAYMENT_PROVIDER_SECRET

# Comma-separated trusted usernames and/or user IDs. No first-user auto-admin exists.
ADMIN_USERS=your-admin-username

MINIO_ROOT_USER=REPLACE_WITH_RANDOM_MINIO_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_PASSWORD
MAX_UPLOAD_BYTES=10737418240
LOCAL_CACHE_MAX_BYTES=2147483648
SFTP_ENABLE=0
SLICES_ENABLE=1
SLICES_PUBLIC_URL=https://slices.example.com
